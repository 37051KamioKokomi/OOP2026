<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="お天気アプリ"
        Height="450"
        Width="600">

    <Grid Background="#EAF6FF">

        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <TextBlock Text="東京の天気"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="10"/>

            <TextBlock x:Name="TemperatureText"
                       Text="気温：取得中..."
                       FontSize="26"
                       Margin="10"/>

            <TextBlock x:Name="WeatherText"
                       Text="天気：取得中..."
                       FontSize="22"
                       Margin="10"/>

            <TextBlock x:Name="HumidityText"
                       Text="湿度：取得中..."
                       FontSize="22"
                       Margin="10"/>

            <TextBlock x:Name="WindSpeedText"
                       Text="風速：取得中..."
                       FontSize="22"
                       Margin="10"/>

        </StackPanel>

    </Grid>

</Window>