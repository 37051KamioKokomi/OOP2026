<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="お天気アプリ"
        Height="700"
        Width="750">

    <Grid Background="#E8F5EF">

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="20">

                <!-- タイトル -->
                <TextBlock Text="東京の天気"
                           FontSize="30"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="10"/>

                <!-- 現在の天気 -->
                <Border Background="#FFFFFF"
                    CornerRadius="20"
                    Padding="25"
                    Margin="10"
                    BorderBrush="#D5EBDD"
                    BorderThickness="1">

                    <StackPanel>

                        <TextBlock x:Name="TemperatureText"
                                   Text="気温：取得中..."
                                   FontSize="26"
                                   Margin="10"/>

                        <TextBlock x:Name="WeatherText"
                                   Text="天気：取得中..."
                                   FontSize="22"
                                   Margin="10"/>

                        <TextBlock x:Name="HumidityText"
                                   Text="湿度：取得中..."
                                   FontSize="22"
                                   Margin="10"/>

                        <TextBlock x:Name="WindSpeedText"
                                   Text="風速：取得中..."
                                   FontSize="22"
                                   Margin="10"/>

                    </StackPanel>

                </Border>

                <!-- 週間予報のタイトル -->
                <TextBlock Text="🌿 7日間の天気予報"
                            FontSize="24"
                             FontWeight="Bold"
                            Foreground="#45665A"
                            Margin="15"
                            HorizontalAlignment="Center"/>

                <!-- 週間予報の見出し -->
                <Border Background="#C8E8D5"
        CornerRadius="8"
        Padding="15"
        Margin="5">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="日付" FontWeight="Bold"
                   Grid.Column="0"/>

                        <TextBlock Text="天気" FontWeight="Bold"
                   Grid.Column="1"/>

                        <TextBlock Text="最高気温" FontWeight="Bold"
                   Grid.Column="2"/>

                        <TextBlock Text="最低気温" FontWeight="Bold"
                   Grid.Column="3"/>

                        <TextBlock Text="降水確率" FontWeight="Bold"
                   Grid.Column="4"/>
                    </Grid>
                </Border>
                
                <!-- 週間予報の表示場所 -->
                <ItemsControl x:Name="WeeklyWeatherList">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border Background="#FFFFFF"
                                CornerRadius="15"
                                Padding="18"
                                Margin="5"
                                BorderBrush="#D5EBDD"
                                BorderThickness="1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Date}"
                                               Grid.Column="0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding WeatherIcon}"
                                            FontSize="24"
                                            HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding WeatherDescription}"
                                            HorizontalAlignment="Center"/>
                                        
                                    </StackPanel>

                                    <TextBlock Text="{Binding MaxTemperature, StringFormat={}{0}℃}"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="#E74C3C"
                                            FontWeight="Bold"/>

                                    <TextBlock Text="{Binding MinTemperature, StringFormat={}{0}℃}"
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Foreground="#3498DB"
                                            FontWeight="Bold"/>

                                    <TextBlock Text="{Binding PrecipitationProbability, StringFormat={}{0}%}"
                                               Grid.Column="4"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>