<Window x:Class="Exercise01_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Exercise01_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">


    <Grid HorizontalAlignment="Left" Width="800">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5*"/>

        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0"
            Content="ファイル選択"
            Click="Button_Click"/>

        <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                 FontSize="16"
             x:Name="TextArea"
             Height="410"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto" HorizontalAlignment="Left" Margin="0,72,0,-48" Grid.RowSpan="2" Width="800"/>
    </Grid>

</Window>
